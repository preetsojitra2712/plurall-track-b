  "kokoro/kokoro_am_adam/1673-143396-0005": {
    "dataset": "kokoro-82M",
    "duration_s": 12.025,
    "engine": "kokoro",
    "native_sr": 24000,
    "output_sr": 16000,
    "resampled": true,
    "source_id": "kokoro_am_adam",
    "text": "The son of a virgin generated by the ineffable operation of the holy spirit was a creature without example or resemblance superior in every attribute of mind and body to the children of adam.",
    "text_normalisation": "caps->sentence-case + terminal period",
    "utterance_id": "1673-143396-0005",
