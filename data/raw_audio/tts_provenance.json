    "output_sr": 16000,
    "resampled": true,
    "source_id": "piper_en_US-lessac-medium",
    "text": "One day when i rode over to the shimerdas i found antonia starting off on foot for russian peter's house to borrow a spade ambrosch needed.",
    "text_normalisation": "caps->sentence-case + terminal period",
    "utterance_id": "2035-147960-0002",
    "voice": "en_US-lessac-medium"
  },
  "piper/piper_en_US-lessac-medium/2086-149214-0001": {
