    "native_sr": 22050,
    "output_sr": 16000,
    "resampled": true,
    "source_id": "piper_en_US-lessac-medium",
    "text": "Many little wrinkles gathered between his eyes as he contemplated this and his brow moistened.",
    "text_normalisation": "caps->sentence-case + terminal period",
    "utterance_id": "2277-149896-0005",
    "voice": "en_US-lessac-medium"
  },
  "piper/piper_en_US-lessac-medium/5536-43358-0003": {
