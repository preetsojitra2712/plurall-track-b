    "duration_s": 5.875,
    "engine": "kokoro",
    "native_sr": 24000,
    "output_sr": 16000,
    "resampled": true,
    "source_id": "kokoro_af_sarah",
    "text": "There had been another black frost the night before and the air was clear and heady as wine.",
